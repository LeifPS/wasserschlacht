{
  "name": "wasserschlacht",
  "main": "worker/index.js",
  "compatibility_date": "2025-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/ws/*"] },
  "durable_objects": {
    "bindings": [
      { "name": "USER", "class_name": "User" },
      { "name": "LOBBY", "class_name": "Lobby" },
      { "name": "MATCH", "class_name": "Match" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["User", "Lobby", "Match"] }]
}
